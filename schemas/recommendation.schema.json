{
  "$defs": {
    "ContextBasis": {
      "additionalProperties": false,
      "properties": {
        "client_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Client Id",
          "type": "string"
        },
        "project": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project"
        },
        "as_of": {
          "format": "date",
          "title": "As Of",
          "type": "string"
        },
        "rule_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Rule Ids",
          "type": "array"
        },
        "rules": {
          "items": {
            "$ref": "#/$defs/ContextRule"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Rules",
          "type": "array"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/ContextReference"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        },
        "used_for": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Used For",
          "type": "string"
        }
      },
      "required": [
        "client_id",
        "as_of",
        "rule_ids",
        "rules",
        "sources",
        "used_for"
      ],
      "title": "ContextBasis",
      "type": "object"
    },
    "ContextReference": {
      "additionalProperties": false,
      "properties": {
        "client_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Client Id",
          "type": "string"
        },
        "material_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Material Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "chunk_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Chunk Id",
          "type": "string"
        },
        "locator": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "title": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "quote": {
          "maxLength": 2400,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "client_id",
        "material_id",
        "sha256",
        "chunk_id",
        "locator",
        "title",
        "quote"
      ],
      "title": "ContextReference",
      "type": "object"
    },
    "ContextRule": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "kind": {
          "const": "context_rule",
          "title": "Kind",
          "type": "string"
        },
        "client_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Client Id",
          "type": "string"
        },
        "rule_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Rule Id",
          "type": "string"
        },
        "key": {
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Key",
          "type": "string"
        },
        "value": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "project": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project"
        },
        "valid_from": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid From"
        },
        "valid_until": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid Until"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/ContextReference"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "client_id",
        "rule_id",
        "key",
        "value",
        "sources"
      ],
      "title": "ContextRule",
      "type": "object"
    },
    "TestPlan": {
      "additionalProperties": false,
      "properties": {
        "hypothesis": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Hypothesis",
          "type": "string"
        },
        "method": {
          "enum": [
            "before_after",
            "observation"
          ],
          "title": "Method",
          "type": "string"
        },
        "baseline": {
          "$ref": "#/$defs/Window"
        },
        "evaluation_days": {
          "maximum": 90,
          "minimum": 1,
          "title": "Evaluation Days",
          "type": "integer"
        },
        "metric": {
          "enum": [
            "cost_per_result",
            "roas",
            "results"
          ],
          "title": "Metric",
          "type": "string"
        },
        "direction": {
          "enum": [
            "increase",
            "decrease"
          ],
          "title": "Direction",
          "type": "string"
        },
        "success_threshold": {
          "anyOf": [
            {
              "decimal_places": 6,
              "ge": 0,
              "gt": 0,
              "max_digits": 20,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Success Threshold"
        },
        "minimum_results": {
          "anyOf": [
            {
              "decimal_places": 6,
              "ge": 0,
              "max_digits": 20,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum Results"
        },
        "stop_condition": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Stop Condition",
          "type": "string"
        }
      },
      "required": [
        "hypothesis",
        "method",
        "baseline",
        "evaluation_days",
        "metric",
        "direction",
        "stop_condition"
      ],
      "title": "TestPlan",
      "type": "object"
    },
    "Window": {
      "additionalProperties": false,
      "properties": {
        "since": {
          "format": "date",
          "title": "Since",
          "type": "string"
        },
        "until": {
          "format": "date",
          "title": "Until",
          "type": "string"
        }
      },
      "required": [
        "since",
        "until"
      ],
      "title": "Window",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "client_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Client Id",
      "type": "string"
    },
    "account_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Account Id",
      "type": "string"
    },
    "kind": {
      "const": "recommendation",
      "title": "Kind",
      "type": "string"
    },
    "recommendation_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Recommendation Id",
      "type": "string"
    },
    "goal_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Goal Id",
      "type": "string"
    },
    "goal_revision": {
      "minimum": 1,
      "title": "Goal Revision",
      "type": "integer"
    },
    "campaign_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Campaign Ids",
      "type": "array"
    },
    "title": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "action": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Action",
      "type": "string"
    },
    "rationale": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    },
    "priority": {
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "title": "Priority",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "maxLength": 2000,
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Evidence Refs",
      "type": "array"
    },
    "context_basis": {
      "anyOf": [
        {
          "$ref": "#/$defs/ContextBasis"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "test_plan": {
      "$ref": "#/$defs/TestPlan"
    },
    "followup_of": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Followup Of"
    },
    "followup_reason": {
      "anyOf": [
        {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Followup Reason"
    }
  },
  "required": [
    "schema_version",
    "client_id",
    "account_id",
    "kind",
    "recommendation_id",
    "goal_id",
    "goal_revision",
    "campaign_ids",
    "title",
    "action",
    "rationale",
    "priority",
    "evidence_refs",
    "test_plan"
  ],
  "title": "Recommendation",
  "type": "object"
}
